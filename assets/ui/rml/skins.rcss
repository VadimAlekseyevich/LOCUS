#skins-root { display:flex; flex-direction:column; width:100%; height:100%; }
.skins-header { flex:0 0 56dp; height:56dp; display:flex; flex-direction:row;
  gap:12dp; align-items:center; padding:7dp 14dp;
  border-bottom:1dp #535873; background-color:#23283bd9; }
.skins-back { flex:0 0 93dp; width:93dp; height:40dp; }
.skins-title { display:block; font-weight:800; font-size:22dp; color:#d0c7fa; }
#skin-dirty { display:block; font-size:11dp; color:#d0c7fa; }
.skins-name { width:210dp; margin-left:auto; height:38dp; flex:0 0 210dp; }
.skins-tabs { display:flex; flex-direction:row; gap:8dp; padding:10dp 14dp;
  flex:0 0 62dp; align-items:center; }
.skins-tabs button { flex:1; min-width:0; height:42dp; font-weight:800; }
.skins-tabs .selected, .skin-profile.selected, .skin-swatch.selected {
  background-color:#585281; border-color:#b5a4f3; color:#f4efff; }
.skins-columns { flex:1; min-height:0; min-width:0; display:flex;
  flex-direction:row; gap:12dp; padding:0 14dp 8dp; }
.skins-left { flex:1.25; min-width:0; overflow-y:auto; padding:12dp; }
.skins-right { flex:1; min-width:0; gap:8dp; padding:12dp; }
#skin-controls { display:block; width:100%; }
.skin-setting-row { display:flex; flex-direction:row; width:100%; min-width:0;
  min-height:49dp; align-items:center; padding:4dp 1dp; gap:9dp;
  border-bottom:1dp #414962; }
.skin-setting-name { display:block; flex:1; min-width:0; font-size:12dp;
  color:#d6ddf3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.skin-range { flex:0 0 32%; width:32%; height:30dp; }
.skin-number { flex:0 0 73dp; width:73dp; height:34dp; background-color:#1b263c;
  border:1dp #647096; border-radius:6dp; font-family:Locus; font-size:12dp;
  color:#eef1fb; text-align:center; }
.skin-setting-row button { flex:0 0 84dp; width:84dp; height:34dp; }
.skin-swatches { display:flex; flex-direction:row; flex-wrap:wrap; gap:5dp; }
.skin-swatch { display:block; flex:0 0 48%; width:48%; height:36dp;
  text-align:left; font-size:11dp; }
.skin-swatch-chip { display:inline-block; width:16dp; height:16dp;
  border:1dp #a6b0cf; margin-right:7dp; }
.skin-channel-heading, .skins-label { display:block; color:#acb6cb;
  font-size:11dp; letter-spacing:0.8dp; font-weight:750; padding:4dp 0; }
.skin-channel-heading { margin-top:12dp; }
.skin-profile-list { display:flex; flex-direction:column; gap:6dp; }
.skin-profile { height:36dp; width:100%; text-align:left; font-size:12dp; }
.skin-profile-actions { display:flex; flex-wrap:wrap; gap:7dp; margin-top:12dp; }
.skin-profile-actions button { flex:0 0 31%; min-width:0; height:34dp; font-size:11dp; }
#skin-color-edit { flex:0 0 auto; }
#skin-preview-canvas { flex:1; min-height:80dp; width:100%;
  border:1dp #6a7195; border-radius:9dp; overflow:hidden; }
.skins-actions { flex:0 0 auto; display:flex; flex-direction:row; gap:6dp; }
.skins-actions button { flex:1; min-width:0; height:39dp; font-size:11dp; }
#skin-notice { display:block; flex:0 0 20dp; height:20dp;
  color:#a2d8ee; padding:1dp 15dp; font-size:10dp; }
#skin-notice.error { color:#ecc3d1; }
#skin-delete-modal { position:absolute; top:0; left:0; width:100%;
  height:100%; align-items:center; justify-content:center;
  background-color:#0a0e19f0; z-index:30; }
.skin-modal-panel { width:56%; padding:25dp; background-color:#292c46;
  border:1dp #b5a4f3; border-radius:14dp; display:flex;
  flex-direction:column; gap:16dp; }
.skin-modal-actions { display:flex; flex-direction:row; gap:12dp; }
.skin-modal-actions button { flex:1; height:42dp; }
@media (max-width:730dp) {
  .skins-columns { padding:0 7dp 5dp; gap:7dp; }
  .skins-left, .skins-right { padding:7dp; }
  .skins-name { width:160dp; flex-basis:160dp; }
  .skin-setting-name { font-size:11dp; }
  .skin-number { width:53dp; flex-basis:53dp; }
  .skin-range { flex-basis:25%; width:25%; }
}
