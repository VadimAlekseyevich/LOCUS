#profile { display:flex; flex-direction:column; width:100%; height:100%; padding:20dp; gap:7dp; }
#profile-summary { font-size:22dp; font-weight:750; color:#d0c7fa; flex:0 0 30dp; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#profile-scores { flex:1; overflow-y:auto; padding:5dp; gap:4dp; }
#profile-empty { padding:0; }
.profile-row { display:none; flex:0 0 34dp; flex-direction:row; align-items:center; gap:7dp; padding:4dp 8dp; background-color:#30354d; border-radius:7dp; font-size:13dp; }
.profile-rank { flex:0 0 30dp; color:#acb6cb; }
.profile-title { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.profile-mods { flex:0 0 24%; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:11dp; color:#acb6cb; }
.profile-acc { flex:0 0 70dp; text-align:right; color:#a2d8ee; }
.profile-pp { flex:0 0 92dp; text-align:right; color:#d0c7fa; font-weight:700; }
#profile-actions { display:flex; flex-direction:row; align-items:center; flex:0 0 32dp; gap:8dp; }
#profile-actions button { width:100dp; height:32dp; }
#profile-page { flex:1; text-align:center; color:#acb6cb; }
@media (max-width:680dp) { #profile-summary { font-size:15dp; } .profile-row { gap:4dp; font-size:11dp; } .profile-rank { flex-basis:22dp; } .profile-acc { flex-basis:56dp; } .profile-pp { flex-basis:67dp; } }
