<rml>
<head>
<title>LOCUS / HOME</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="home.rcss" />
</head>
<body>
<div id="home">
  <div id="home-main">
    <!-- Approved PNG drawn by HomeBrandAssets at this responsive RmlUi box. -->
    <div id="home-wordmark"></div>
    <div id="home-actions">
      <button id="home-play" class="home-action" data-action="home-play">PLAY</button>
      <button id="home-editor" class="home-action" data-action="home-editor">EDITOR</button>
      <button id="home-skins" class="home-action" data-action="home-skins">SKINS</button>
      <button id="home-settings" class="home-action" data-action="home-settings">SETTINGS</button>
    </div>
  </div>
  <div id="home-notice"></div>
  <button id="home-exit" class="quiet" data-action="home-exit">EXIT</button>
</div>
</body>
</rml>
