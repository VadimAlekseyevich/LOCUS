/* HOME uses the same menu-only Nightbloom controls as PLAY. */
#home { display:flex; flex-direction:column; align-items:center;
  justify-content:center; position:relative; width:100%; height:100%;
  padding:24dp 4vw; }
#home-main { display:flex; flex-direction:column; align-items:center;
  justify-content:center; width:100%; min-height:0; }
#home-wordmark { display:block; width:330dp; height:98dp;
  max-width:75%; margin:0 0 68dp; }
#home-actions { display:flex; flex-direction:row; width:94%;
  max-width:900dp; gap:12dp; }
.home-action { flex:1; min-width:0; height:80dp; padding:12dp 4dp;
  font-size:19dp; text-align:center; font-weight:600; }
.home-action:focus { border:2dp #d5effb; }
#home-skins { background-color:#333f63; border-color:#7b92ba; }
#home-skins:hover { background-color:#4b608c; border-color:#a2d8ee; }
#home-settings { background-color:#3c3b61; border-color:#8b82bb; }
#home-settings:hover { background-color:#555487; border-color:#b2a4ef; }
#home-exit { position:absolute; right:5vw; bottom:5vh; width:122dp;
  height:46dp; background-color:#2a3047; border-color:#565c80; }
#home-exit:hover { background-color:#434e6b; }
#home-notice { position:absolute; left:5vw; bottom:5vh; width:68%;
  color:#efabbc; font-size:13dp; }
@media (max-height:520dp) {
  #home-wordmark { width:255dp; height:76dp; margin-bottom:36dp; }
  .home-action { height:64dp; }
}
@media (max-width:680dp) {
  #home-actions { width:100%; gap:6dp; }
  .home-action { font-size:14dp; }
}
