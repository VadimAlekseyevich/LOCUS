<rml>
<head>
<title>LOCUS / PLAY</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="play.rcss" />
</head>
<body>
<div id="app">
  <div id="heading">
    <button class="back quiet" data-action="back"><span class="button-label">&#8592; BACK</span></button>
    <div class="heading-title">PLAY</div>
  </div>
  <div id="workspace">
    <div id="details" class="panel">
      <div id="summary">
        <div id="pack-section">
          <div class="eyebrow">SONG SET</div>
          <div id="song-title">BUILT-IN DEMO</div>
          <div id="song-author">LOCUS</div>
          <div id="song-mapper"></div>
          <div id="song-meta">120 BPM</div>
          <div id="song-tags"></div>
        </div>
        <div id="difficulty-section">
          <div class="difficulty-heading">
            <div class="eyebrow">DIFFICULTY</div>
            <div id="rating">0.8</div>
          </div>
          <div id="chart-title">ORIGINAL</div>
          <div id="chart-notes">9 TURNS</div>
          <div id="metrics">
            <div class="metrics-row">
              <div class="metric"><span>Speed</span><strong id="metric-speed">0.0</strong></div>
              <div class="metric"><span>Rhythm</span><strong id="metric-rhythm">0.0</strong></div>
              <div class="metric"><span>Coord.</span><strong id="metric-coord">0.0</strong></div>
            </div>
            <div class="metrics-row">
              <div class="metric"><span>Reading</span><strong id="metric-reading">0.0</strong></div>
              <div class="metric"><span>Stamina</span><strong id="metric-stamina">0.0</strong></div>
              <div class="metric"><span>Peak</span><strong id="metric-peak">0.0</strong></div>
            </div>
          </div>
        </div>
      </div>
      <div id="history">
        <div class="history-heading">
          <span>RESULTS</span><span id="result-count" class="count-pill">0</span>
        </div>
        <div id="results-scroll"><div id="results-list"></div></div>
      </div>
      <div id="notice"></div>
      <div id="commands">
        <button id="start" data-action="play" class="primary"><span class="button-label">PLAY</span></button>
        <button id="edit" data-action="edit" class="secondary"><span class="button-label">EDIT</span></button>
      </div>
    </div>
    <div id="library" class="panel">
      <div class="library-heading">
        <span>SONGS &amp; CHARTS</span>
        <span id="set-count" class="count-pill">1</span>
      </div>
      <input id="search" class="ui-input" type="text" placeholder="Search songs..." maxlength="64" />
      <div id="tree-scroll"><div id="tree"></div></div>
      <div id="library-footer">
        <button id="set-button" data-action="song-set" class="quiet"><span class="button-label">SONG SET</span></button>
        <button data-action="import" class="quiet"><span class="button-label">IMPORT</span></button>
        <button data-action="rescan" class="quiet"><span class="button-label">RESCAN</span></button>
      </div>
    </div>
  </div>
</div>
</body>
</rml>
