<rml>
<head>
<title>LOCUS / PLAY</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="play.rcss" />
</head>
<body>
<div id="app">
  <div id="workspace">
    <div id="details" class="panel">
      <div id="summary">
        <div id="pack-section">
          <div class="eyebrow">SONG SET</div>
          <div id="song-title">BUILT-IN DEMO</div>
          <div id="song-author">LOCUS</div>
          <div id="song-mapper"></div>
          <div id="song-meta">120 BPM</div>
          <div id="song-tags"></div>
        </div>
        <div id="difficulty-section">
          <div class="difficulty-heading">
            <div id="difficulty-label" class="eyebrow">DIFFICULTY V4</div>
            <div id="rating">0.8</div>
          </div>
          <div id="chart-title">ORIGINAL</div>
          <div id="chart-notes">9 EVENTS / 9 KEYS</div>
          <div id="metrics">
            <div class="metrics-row">
              <div class="metric"><span>Speed</span><strong id="metric-speed">0.0</strong></div>
              <div class="metric"><span>Fingers</span><strong id="metric-fingers">0.0</strong></div>
              <div class="metric"><span>Coord.</span><strong id="metric-coord">0.0</strong></div>
            </div>
            <div class="metrics-row">
              <div class="metric"><span>Rhythm</span><strong id="metric-rhythm">0.0</strong></div>
              <div class="metric"><span>Stamina</span><strong id="metric-stamina">0.0</strong></div>
              <div class="metric" title="Visual diagnostic only; not included in difficulty"><span>Read*</span><strong id="metric-reading">0.0</strong></div>
            </div>
          </div>
        </div>
      </div>
      <div id="history">
        <div class="history-heading">
          <span>RESULTS</span><span id="result-count" class="count-pill">0</span>
        </div>
        <div id="results-scroll"><div id="results-list"></div></div>
      </div>
      <div id="notice"></div>
    </div>
    <div id="library" class="panel">
      <div class="library-heading">
        <span>SONGS &amp; CHARTS</span>
        <span id="set-count" class="count-pill">1</span>
      </div>
      <input id="search" class="ui-input" type="text" placeholder="Search songs..." maxlength="64" />
      <div id="tree-scroll"><div id="tree"></div></div>
      <div id="library-footer">
        <button id="edit" data-action="edit" class="quiet"><span class="button-label">EDIT</span></button>
        <button id="mods-button" data-action="mods-open" class="secondary"><span class="button-label">MODS</span></button>
        <button data-action="import" class="quiet"><span class="button-label">IMPORT</span></button>
        <button data-action="rescan" class="quiet"><span class="button-label">RESCAN</span></button>
      </div>
    </div>
  </div>
  <div id="mods-overlay">
    <div id="mods-panel" class="panel">
      <div class="mods-heading"><span>MODIFIERS</span><button data-action="mods-close" class="quiet"><span class="button-label">CLOSE</span></button></div>
      <div id="mods-content">
        <div class="eyebrow">SPEED</div>
        <div class="rate-row"><button id="mod-ht" data-action="mod-ht" class="secondary"><span class="button-label">Half Time</span></button><input type="range" id="ht-rate" min="50" max="99" step="1" value="75"/><span id="mod-ht-label">75%</span></div>
        <div class="rate-row"><button id="mod-dt" data-action="mod-dt" class="secondary"><span class="button-label">Double Time</span></button><input type="range" id="dt-rate" min="101" max="150" step="1" value="125"/><span id="mod-dt-label">125%</span></div>
        <div class="eyebrow">JUDGEMENT</div><div class="mods-row"><button id="mod-ez" data-action="mod-ez" class="secondary"><span class="button-label">Easy (EZ)</span></button><button id="mod-hr" data-action="mod-hr" class="secondary"><span class="button-label">Hard Rock (HR)</span></button></div>
        <div class="eyebrow">VISIBILITY</div><div class="mods-row"><button id="mod-hd" data-action="mod-hd" class="secondary"><span class="button-label">Hidden (HD)</span></button><button id="mod-fl" data-action="mod-fl" class="secondary"><span class="button-label">Flashlight (FL)</span></button></div>
        <div class="eyebrow">TRANSFORM</div><div class="mods-row"><button id="mod-mr" data-action="mod-mr" class="secondary"><span class="button-label">Mirror (MR)</span></button><button id="mod-rd" data-action="mod-rd" class="secondary"><span class="button-label">Random (RD)</span></button></div>
        <div class="eyebrow">FAIL CONDITIONS</div><div class="mods-row"><button id="mod-sd" data-action="mod-sd" class="secondary"><span class="button-label">Sudden Death (SD)</span></button><button id="mod-pf" data-action="mod-pf" class="secondary"><span class="button-label">Perfect (PF)</span></button></div>
        <div class="eyebrow">ASSIST / WATCH</div><div class="mods-row"><button id="mod-at" data-action="mod-at" class="secondary"><span class="button-label">Autoplay (AT)</span></button><button id="mod-cn" data-action="mod-cn" class="secondary"><span class="button-label">Cinema (CN)</span></button></div>
      </div>
      <div class="mods-heading"><span id="mods-selection">NM</span><button data-action="mods-reset" class="quiet"><span class="button-label">RESET</span></button></div>
    </div>
  </div>
</div>
</body>
</rml>
