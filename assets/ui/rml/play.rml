<rml>
<head>
<title>LOCUS / PLAY</title>
<link type="text/rcss" href="play.rcss" />
</head>
<body>
<div id="app">
  <div id="heading">
    <button class="back" data-action="back">BACK</button>
    <div class="heading-title">PLAY</div>
  </div>
  <div id="workspace">
    <div id="details" class="panel">
      <div id="summary">
        <div class="eyebrow">SONG SET</div>
        <div id="song-title">BUILT-IN DEMO</div>
        <div class="subline" id="song-author">LOCUS</div>
        <div class="meta" id="song-meta">120 BPM</div>
        <div class="rule"></div>
        <div class="eyebrow">DIFFICULTY</div>
        <div class="difficulty-heading">
          <div id="chart-title">ORIGINAL</div>
          <span id="rating">0.0</span>
        </div>
        <div class="meta" id="chart-notes">0 TURNS</div>
        <div class="metric" id="metrics-a">SPD —  RHY —  COORD —</div>
        <div class="metric" id="metrics-b">READ —  STA —  PEAK —</div>
      </div>
      <div id="history">
        <div class="history-heading">RESULTS <span id="result-count">0</span></div>
        <div id="results-scroll"><div id="results-list"></div></div>
      </div>
      <div id="commands">
        <button id="start" data-action="play" class="primary">PLAY</button>
        <button id="edit" data-action="edit" class="secondary">EDIT</button>
      </div>
    </div>
    <div id="library" class="panel">
      <div class="library-heading">SONGS / CHARTS</div>
      <input id="search" type="text" placeholder="Search songs..." maxlength="64" />
      <div id="tree-scroll"><div id="tree"></div></div>
      <div id="library-footer">
        <span id="row-count">0 SONGS</span>
        <button data-action="rescan" class="quiet">RESCAN</button>
      </div>
    </div>
  </div>
</div>
</body>
</rml>
