#results-root { display:flex; flex-direction:column; width:100%; height:100%; }
.results-columns { display:flex; flex-direction:row; flex:1; min-height:0; min-width:0;
  gap:12dp; padding:12dp 14dp; }
.results-panel { flex:1; min-width:0; padding:20dp; }
.results-main { display:flex; flex-direction:column; justify-content:space-between; overflow-y:auto; }
.results-side { display:flex; flex-direction:column; gap:12dp; }
.results-eyebrow { display:block; font-size:13dp; font-weight:800; color:#b5a4f3; letter-spacing:1dp; }
.results-song { display:block; font-size:26dp; font-weight:800; color:#eef1fb;
  margin-top:10dp; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.results-chart { display:block; font-size:16dp; color:#c0c9e2; margin-top:6dp; }
.results-muted { display:block; color:#acb6cb; font-size:12dp; margin-top:6dp; }
.results-accuracy { display:block; font-size:50dp; font-weight:800; color:#d0c7fa; margin-top:5dp; }
.results-notes { display:block; font-size:26dp; font-weight:750; margin-top:7dp; }
.results-actions { display:flex; flex-direction:row; gap:9dp; }
.results-actions button { flex:1; min-width:0; height:45dp; }
.results-block-title { display:block; color:#cfc1fa; font-size:14dp;
  font-weight:800; letter-spacing:1dp; }
.results-grid { display:flex; flex-direction:row; flex-wrap:wrap; gap:9dp; }
.results-grade { display:flex; flex-direction:column; justify-content:space-between;
  flex:0 0 46%; min-width:0; height:92dp; border:1dp #595f81;
  border-radius:10dp; padding:12dp; background-color:#282e46; color:#bbc7e4; }
.results-grade strong { display:block; font-size:30dp; color:#eef1fb; }
.results-separator { border-top:1dp #535a79; padding-top:14dp; }
#results-history { flex:1; min-height:0; overflow-y:auto; }
#results-history-list { display:flex; flex-direction:column; gap:6dp; }
.results-history-spacer { flex-shrink:0; width:1dp; }
.results-history-row { display:block; width:100%; flex:0 0 36dp;
  height:36dp; font-size:12dp; text-align:left; }
.results-empty { display:block; color:#9da8c6; padding:9dp; font-size:12dp; }
@media (max-width:730dp) {
  .results-columns { gap:7dp; padding:7dp; }
  .results-panel { padding:10dp; }
  .results-song { font-size:20dp; }
  .results-accuracy { font-size:37dp; }
}
