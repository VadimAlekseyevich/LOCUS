<rml><head><title>LOCUS / SKINS</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="skins.rcss" /></head>
<body><div id="skins-root">
 <div class="skins-tabs">
  <button id="skin-tab-profiles" class="selected" data-action="tab" data-index="3"><span class="button-label">SKINS</span></button>
  <button id="skin-tab-path" data-action="tab" data-index="0"><span class="button-label">PATH</span></button>
  <button id="skin-tab-player" data-action="tab" data-index="1"><span class="button-label">PLAYER</span></button>
  <button id="skin-tab-hit-error" data-action="tab" data-index="4"><span class="button-label">HIT ERROR</span></button>
  <button id="skin-tab-colors" data-action="tab" data-index="2"><span class="button-label">COLORS</span></button>
 </div>
 <div class="skins-columns">
  <div class="panel skins-left">
   <div id="skin-name-row" class="skin-name-row"><div class="skins-label">SKIN NAME</div><input id="skin-name" class="ui-input ui-input-compact skins-name" type="text" data-kind="name" value="Default"/></div>
   <div id="skin-controls"></div>
   <div id="skin-color-edit" style="display:none;">
    <input id="skin-hex" type="text" class="ui-input ui-input-compact" data-kind="hex" value="#FF4654FF"/>
   </div>
  </div>
  <div class="panel skins-right">
   <div class="skins-label">LIVE PREVIEW</div>
   <div id="skin-preview-canvas"></div>
   <div class="skins-actions">
    <button data-action="load"><span class="button-label">LOAD</span></button>
    <button data-action="save" class="primary"><span class="button-label">SAVE</span></button>
    <button data-action="saveas"><span class="button-label">SAVE AS</span></button>
    <button data-action="reset" class="quiet"><span class="button-label">RESET</span></button>
   </div>
  </div>
 </div>
 <div class="skin-status"><div id="skin-notice"></div><div id="skin-dirty"></div></div>
 <div id="skin-delete-modal" class="ui-modal-layer" style="display:none;">
  <div id="skin-delete-panel" class="ui-modal-panel">
   <div id="skin-delete-title" class="ui-modal-heading">DELETE SKIN?</div>
   <div>Selected profile moves to recoverable Trash.</div>
   <div class="ui-modal-actions">
    <button class="primary" data-action="delete-confirm"><span class="button-label">DELETE</span></button>
    <button id="skin-delete-cancel" class="quiet" data-action="delete-cancel"><span class="button-label">CANCEL</span></button>
   </div>
  </div>
 </div>
</div></body></rml>
