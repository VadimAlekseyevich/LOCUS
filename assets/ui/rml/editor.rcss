/* Editor shell aligns to the existing 960x540 editor viewport.
   Chart preview and timelines remain raylib; all Song Setup panels are RmlUi.
   No gameplay-related visuals or controls run through RmlUi. */
#editor-canvas { position:absolute; left:0; top:0;
  width:960dp; height:540dp; background-color:transparent; }
#editor-header { position:absolute; left:43dp; top:65dp;
  width:899dp; height:45dp; display:flex; flex-direction:row;
  align-items:center; gap:7dp; padding:4dp 6dp;
  border:1dp #555d80; border-radius:10dp;
  background-color:#272c42; }
#editor-back { width:99dp; flex:0 0 99dp; height:35dp;
  font-size:13dp; font-weight:750; color:#cfc1fa; }
.editor-caption { display:flex; align-items:center; flex:1; min-width:0;
  overflow:hidden; gap:7dp; padding:0 5dp; color:#eef1fb; }
#editor-chart-name { display:block; overflow:hidden; white-space:nowrap;
  text-overflow:ellipsis; font-size:15dp; font-weight:750; }
#editor-dirty { color:#b5a4f3; font-size:18dp; font-weight:800; }
#editor-footer-playback { position:absolute; left:52dp; top:485dp;
  display:flex; flex-direction:row; gap:5dp; }
#editor-footer-playback button { width:39dp; height:40dp; padding:1dp;
  font-size:10dp; font-weight:800; border-radius:8dp; }
#editor-footer-rate-time { position:absolute; left:725dp; top:485dp;
  display:flex; flex-direction:row; gap:9dp; }
#editor-footer-rate-time button { height:40dp; border-radius:9dp;
  padding:2dp 3dp; font-weight:750; font-size:12dp; }
#editor-rate-control { display:flex; position:relative; width:93dp;
  height:40dp; flex:0 0 93dp; align-items:center; }
#editor-preview-rate { display:block; width:100%; height:40dp;
  border:1dp #626785; border-radius:9dp; background-color:#2a3046;
  color:#cfc1fa; font-family:Locus; font-size:13dp; font-weight:750;
  text-align:center; line-height:38dp; padding:0 9dp; tab-index:auto; }
#editor-preview-rate:focus { border:2dp #b5a4f3; background-color:#323b57; }
.editor-rate-unit { position:absolute; right:12dp; top:50%; margin-top:-0.55em;
  line-height:1.1; color:#cfc1fa; font-size:12dp; pointer-events:none; }
#editor-preview-time { width:105dp; }

#editor-route-ui { position:absolute; left:0; top:0; width:960dp; height:540dp; pointer-events:none; }
#editor-route-tools { position:absolute; left:52dp; top:181dp; width:42dp; height:272dp; display:flex; flex-direction:column; gap:4dp; pointer-events:auto; }
#editor-route-tools button, .editor-tool-gap { width:42dp; height:42dp; flex:0 0 42dp; padding:0; font-size:22dp; }
.editor-tool-gap { pointer-events:none; }
#editor-route-pad { position:absolute; left:748dp; top:181dp; width:184dp; height:175dp; display:flex; flex-direction:row; flex-wrap:wrap; gap:5dp; pointer-events:auto; }
#editor-route-pad button { position:relative; flex:0 0 58dp; width:58dp; height:55dp; padding:4dp 2dp; font-size:25dp; color:#d5eeff; }
#editor-route-pad .button-label { font-size:25dp; }
#editor-route-tools .button-label { font-size:24dp; }
.editor-icon-label { font-family:LocusIcons; font-weight:normal;
  color:#a2d8ee; }
.editor-pad-count { position:absolute; right:5dp; bottom:5dp;
  line-height:1; font-size:10dp; color:#c9bbfa; }
#editor-route-pad button.selected { background-color:#585281; border-color:#b5a4f3; }
#editor-route-speed, #editor-route-path { position:absolute; left:748dp; width:184dp; height:31dp; pointer-events:auto; display:flex; flex-direction:row; align-items:center; gap:4dp; }
#editor-route-speed { top:406dp; }
#editor-route-path { top:442dp; }
.editor-option-label { display:block; font-size:11dp; color:#bac5dc; width:47dp; }
.editor-option-value { display:block; font-size:10dp; color:#a2d8ee; overflow:hidden; white-space:nowrap; width:50dp; }
#editor-route-speed button, #editor-route-path button { width:36dp; flex:0 0 36dp; height:28dp; padding:0; font-size:15dp; }

/* All SET fields and action layout live in RCSS; the SongLibrary retains
   exclusive ownership of metadata and difficulty identities. */
#editor-set-ui { position:absolute; left:0; top:0; width:960dp; height:540dp; pointer-events:none; }
.editor-set-panel { position:absolute; top:117dp; height:353dp; padding:10dp;
  border:1dp #565d7b; border-radius:10dp; background-color:#252d45;
  display:flex; flex-direction:column; pointer-events:auto; }
#editor-set-metadata { left:43dp; width:300dp; }
#editor-set-difficulties { left:647dp; width:290dp; }
#editor-set-audio { left:350dp; width:290dp; }
#editor-attach-audio, #editor-tempo-add { flex:0 0 30dp; height:30dp; padding:0; font-size:11dp; }
#editor-attach-audio { margin-bottom:4dp; }
.editor-setup-caption { display:block; color:#a6bad9; font-size:9dp; white-space:nowrap;
  overflow:hidden; text-overflow:ellipsis; margin:3dp 0 6dp; }
.editor-tempo-heading { margin-top:7dp; margin-bottom:3dp; }
.editor-tempo-row { display:flex; flex-direction:row; align-items:center; gap:4dp; flex:0 0 27dp; height:27dp; }
.editor-tempo-offset { flex:1; min-width:0; }
.editor-tempo-bpm { flex:1; min-width:0; }
.editor-tempo-action { flex:0 0 48dp; width:48dp; }
.editor-tempo-labels { flex:0 0 15dp; height:15dp; color:#a6bad9; font-size:10dp; }
.editor-tempo-row input { width:auto; }
.editor-tempo-row button { height:27dp; padding:0; font-size:10dp; }
.editor-tempo-start { color:#a2d8ee; font-size:10dp; text-align:center; }
#editor-tempo-list { display:flex; flex-direction:column; flex:1; min-height:0; gap:4dp; overflow-y:auto; margin-bottom:6dp; }
.editor-set-title { display:block; color:#b5a4f3; font-weight:800; font-size:13dp;
  margin-bottom:6dp; letter-spacing:1dp; }
.editor-set-field { display:flex; flex-direction:column; flex:0 0 auto;
  gap:3dp; margin-bottom:3dp; }
.editor-set-field div { display:block; font-size:10dp; color:#a6bad9; }
.editor-set-input { display:block; width:100%; height:27dp;
  background-color:#1c263e; border:1dp #606c92; border-radius:6dp;
  color:#edf1fc; font-family:Locus; font-size:13dp; padding:3dp 7dp; }
.editor-set-input:focus { border-color:#b5a4f3; background-color:#323354; }
#editor-set-manage { display:flex; flex-direction:row; flex-wrap:wrap;
  gap:4dp; margin-top:auto; }
#editor-set-manage button { flex:0 0 48%; height:25dp; padding:0;
  font-size:9dp; }
.editor-set-quick { display:flex; flex-direction:row; gap:5dp;
  margin-bottom:6dp; }
.editor-set-quick button { flex:1; height:30dp; min-width:0;
  padding:0; font-size:10dp; }
#editor-set-list { display:flex; flex-direction:column; flex:1;
  gap:5dp; overflow-y:auto; min-height:0; }
.editor-set-row { display:block; flex:0 0 30dp; width:100%; min-height:30dp; height:30dp; padding:2dp 5dp; font-size:12dp; }
.editor-set-row.active { border-color:#a2d8ee; }
.editor-set-row.selected { background-color:#59527a; border-color:#a2d8ee; }
#editor-set-hint { position:absolute; left:54dp; top:456dp;
  color:#9da8c6; font-size:9dp; pointer-events:none; }
