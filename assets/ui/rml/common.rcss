/* LOCUS shared Nightbloom theme. RmlUi-only; not gameplay. */
body {
  margin:0; padding:0; width:100%; height:100%;
  background-color: transparent;
  color:#eef1fb;
  font-family:Locus;
  font-size:16dp;
}
* { box-sizing:border-box; }
button { color:#eff2ff; font-family:Locus; font-size:15dp; background-color:#303650;
  border:1dp #62698c; border-radius:13dp; padding:10dp 18dp; cursor:pointer;
  transition: background-color 0.13s sine-out, border-color 0.13s sine-out; }
button:hover { background-color:#444e72; border-color:#a2d8ee; }
button:active { background-color:#5b628e; }
button:focus { border-color:#a2d8ee; }
.panel { background-color:#1e2437ed; border:1dp #4c5079d0; border-radius:16dp;
  padding:18dp 20dp; min-width:0; min-height:0; }
.eyebrow { color:#baabf5; font-size:11dp; letter-spacing:1dp; }
.subline { color:#a2d8ee; margin:0 0 8dp; font-size:14dp; }
.meta { font-size:12dp; color:#a5b1cb; margin:7dp 0; }
.rule { height:1dp; background-color:#454d70; margin:13dp 0; }
.empty { padding:13dp 5dp; color:#97a6c4; }
.primary { background-color:#a2d8ee; color:#20253b; border-color:#a2d8ee; }
.primary:hover { background-color:#c7ecf8; }
.secondary { background-color:#b2a4ef; color:#25243a; border-color:#b2a4ef; }
.secondary:hover { background-color:#cec6fc; }
.ui-input { display:block; width:100%; height:44dp; background-color:#303650;
  border:1dp #444d71; border-radius:12dp; padding:7dp 15dp;
  font-family:Locus; font-size:15dp; color:#eef1fb;
  transition: background-color 0.13s sine-out, border-color 0.13s sine-out; }
.ui-input:focus { border-color:#a2d8ee; background-color:#3a4264; }
