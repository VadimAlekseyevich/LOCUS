/* LOCUS Nightbloom menu components. Gameplay renders separately in raylib. */
div, body, p { display:block; }
span { display:inline; }
strong { font-weight:bold; }
* { box-sizing:border-box; }
body { margin:0; padding:0; width:100%; height:100%;
  color:#eef1fb; font-family:Locus; font-size:15dp;
  background-color:transparent; }
/* RmlUi's flex layout does not reliably render text inside button
   elements, even when labels have a span wrapper. Keep buttons as native
   inline-blocks; their parent flex containers still size and place them. */
button { display:inline-block; position:relative; tab-index:auto;
  font-family:Locus; font-size:14dp; font-weight:650;
  color:#eef1fb; cursor:pointer; text-align:center;
  background-color:#30364e; border:1dp #666b94;
  border-radius:10dp; padding:8dp 12dp;
  transition:background-color 0.12s sine-out, border-color 0.12s sine-out, color 0.12s sine-out; }
/* RmlUi currently does not offset our absolute text with translateY().
   Center the actual line box mathematically instead: top at half the
   button, then move back half the label's own 1.1em line height.
   Keep the button inline-block to preserve text rendering and focus. */
.button-label { display:block; position:absolute;
  left:0; right:0; top:50%; height:1.1em;
  margin:-0.55em 0 0; padding:0;
  min-width:0; max-width:100%;
  overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
  text-align:center; line-height:1.1; }
button:hover { background-color:#414763; border-color:#a2d8ee; }
button:active { background-color:#565a7b; }
button:focus { border:2dp #c8dcff; }
button:disabled { opacity:0.40; cursor:default; }
.primary { background-color:#b3a4ef; color:#25253d; border-color:#cec2ff; }
.primary:hover { background-color:#c7bafa; border-color:#e2dcff; color:#22253b; }
.secondary { background-color:#323e5b; color:#a2d8ee; border-color:#819fc0; }
.secondary:hover { background-color:#465476; border-color:#bdeaff; }
.quiet { background-color:#2a3046; color:#acb6cb; border-color:#626785; }
.quiet:hover { background-color:#3b435e; color:#eef1fb; }
.panel { display:flex; flex-direction:column; min-width:0; min-height:0;
  padding:0; background-color:#20263bcc;
  border:1dp #535a79b0; border-radius:14dp; }
.eyebrow { display:block; color:#b5a4f3;
  font-size:10dp; font-weight:750; letter-spacing:1dp; }
.subline { display:block; color:#a2d8ee; font-size:14dp; }
.meta { display:block; font-size:11dp; color:#acb6cb; }
.empty { display:block; color:#acb6cb; font-size:12dp; padding:12dp; }
.count-pill { display:inline-block; min-width:24dp; text-align:center;
  padding:4dp 8dp; border:1dp #6d668f; border-radius:7dp;
  background-color:#363452; color:#d0c7fa; font-size:11dp; font-weight:bold; }
.ui-input { display:block; tab-index:auto; width:100%; height:40dp;
  background-color:#192237; color:#eef1fb; font-family:Locus;
  font-size:13dp; border:1dp #565f80; border-radius:9dp;
  padding:7dp 13dp; transition:border-color 0.12s sine-out; }
.ui-input:focus { border:2dp #a2d8ee; background-color:#252c43; }

/* Native single-line inputs start their line at the content-box origin.
   34dp = 2 x 1dp border + 2 x 8dp padding + 16dp line.
   Keep the border width constant on focus so the caret, selection and
   text share the same centered line box at every display density. */
.ui-input.ui-input-compact { height:34dp; line-height:16dp;
  padding:8dp 8dp; border-width:1dp; }
.ui-input.ui-input-compact:focus { border-width:1dp; }

/* Scrollbar parts are unstyled/invisible in vanilla RmlUi. */
scrollbarvertical { width:8dp; margin:3dp 0; }
scrollbarvertical slidertrack { background-color:#303750; border-radius:4dp; }
scrollbarvertical sliderbar { background-color:#7776ad; border-radius:4dp;
  min-height:24dp; }
scrollbarvertical sliderbar:hover { background-color:#b4a5ed; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
  height:0; width:0; }

/* Shared responsive modal primitives. The layer owns the entire pointer
   surface; the panel and its scrollable content use normal flex layout. */
.ui-modal-layer { position:absolute; left:0; top:0; width:100%; height:100%;
  z-index:30; display:flex; align-items:center; justify-content:center;
  background-color:#0a0e19a0; padding:12dp; pointer-events:auto; }
.ui-modal-panel { display:flex; flex-direction:column; min-width:0; min-height:0;
  width:90%; max-width:420dp; max-height:100%; padding:16dp; gap:8dp;
  background-color:#252d43; border:1dp #819fc0; border-radius:12dp; }
.ui-modal-heading { display:block; color:#a2d8ee; font-size:17dp; font-weight:800; }
.ui-modal-actions { display:flex; flex-direction:row; gap:8dp; flex:0 0 38dp; }
.ui-modal-actions button { flex:1; min-width:0; height:38dp; padding:4dp; }

/* Confirmation overlays are above other native modals (e.g. Compare).
   Their backdrop is intentionally non-dismissible; only explicit choices act. */
.ui-confirmation-layer { z-index:40; background-color:#0a0e19d9; }
.ui-confirmation-notice { min-height:0; overflow-y:auto; word-break:break-word; }
#confirmation-approve { color:#f0b7b7; border-color:#a97588; }
