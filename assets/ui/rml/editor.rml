<rml>
<head>
<title>LOCUS / EDITOR</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="editor.rcss" />
</head>
<body>
<div id="editor-canvas">
  <div id="editor-route-ui">
    <div id="editor-ruler-row">
      <div id="editor-note-ruler" class="editor-canvas-slot"></div>
      <div id="editor-ruler-controls">
        <div class="editor-ruler-control"><div id="editor-snap-label" class="editor-option-label">SNAP</div><button data-action="snap-less"><span class="button-label">−</span></button><button data-action="snap-more"><span class="button-label">+</span></button></div>
        <div class="editor-ruler-control"><div id="editor-zoom-label" class="editor-option-label">ZOOM</div><button data-action="zoom-out"><span class="button-label">−</span></button><button data-action="zoom-in"><span class="button-label">+</span></button></div>
      </div>
    </div>
    <div id="editor-route-workspace">
    <div id="editor-route-tools">
    <button id="editor-tool-mirror-h" data-action="mirror-h" title="MIRROR H"><span class="button-label editor-icon-label">↔</span></button>
    <button id="editor-tool-mirror-v" data-action="mirror-v" title="MIRROR V"><span class="button-label editor-icon-label">↕</span></button>
    <button id="editor-tool-rotate-ccw" data-action="rotate-ccw" title="ROTATE LEFT"><span class="button-label editor-icon-label">↶</span></button>
    <button id="editor-tool-rotate-cw" data-action="rotate-cw" title="ROTATE RIGHT"><span class="button-label editor-icon-label">↷</span></button>
    <button id="editor-tool-compare" data-action="compare-toggle" title="COMPARE CHARTS"><span class="button-label">CMP</span></button>
    <button id="editor-tool-test" data-action="test-chart" title="TEST CHART"><span class="button-label editor-icon-label">▶</span></button>
    </div>
    <div id="editor-preview-slot" class="editor-canvas-slot"></div>
    <div id="editor-route-inspector">
    <div id="editor-route-pad">
    <button id="editor-pad-7" data-action="note" data-heading="7" title="UP LEFT"><span class="button-label editor-icon-label">↖</span><span id="editor-count-7" class="editor-pad-count">0</span></button>
    <button id="editor-pad-0" data-action="note" data-heading="0" title="UP"><span class="button-label editor-icon-label">↑</span><span id="editor-count-0" class="editor-pad-count">0</span></button>
    <button id="editor-pad-4" data-action="note" data-heading="4" title="UP RIGHT"><span class="button-label editor-icon-label">↗</span><span id="editor-count-4" class="editor-pad-count">0</span></button>
    <button id="editor-pad-3" data-action="note" data-heading="3" title="LEFT"><span class="button-label editor-icon-label">←</span><span id="editor-count-3" class="editor-pad-count">0</span></button>
    <button data-action="remove-note" ><span class="button-label">DEL</span></button>
    <button id="editor-pad-1" data-action="note" data-heading="1" title="RIGHT"><span class="button-label editor-icon-label">→</span><span id="editor-count-1" class="editor-pad-count">0</span></button>
    <button id="editor-pad-6" data-action="note" data-heading="6" title="DOWN LEFT"><span class="button-label editor-icon-label">↙</span><span id="editor-count-6" class="editor-pad-count">0</span></button>
    <button id="editor-pad-2" data-action="note" data-heading="2" title="DOWN"><span class="button-label editor-icon-label">↓</span><span id="editor-count-2" class="editor-pad-count">0</span></button>
    <button id="editor-pad-5" data-action="note" data-heading="5" title="DOWN RIGHT"><span class="button-label editor-icon-label">↘</span><span id="editor-count-5" class="editor-pad-count">0</span></button>
    </div>
    <div id="editor-route-options">
    <div id="editor-route-speed"><div class="editor-option-label">SPEED</div><div id="editor-speed-label" class="editor-option-value">135 px/s</div><button data-action="speed-minus" ><span class="button-label">−</span></button><button data-action="speed-plus" ><span class="button-label">+</span></button></div>
    <div id="editor-route-path"><div class="editor-option-label">PATH</div><div id="editor-path-label" class="editor-option-value">800 ms</div><button data-action="path-minus" ><span class="button-label">−</span></button><button data-action="path-plus" ><span class="button-label">+</span></button></div>
    </div>
    </div>
    </div>
  </div>
  <div id="editor-set-ui" style="display:none;">
    <div id="editor-set-metadata" class="editor-set-panel">
      <div class="editor-set-title">SONG DETAILS</div>
      <div class="editor-set-field"><div>SONG TITLE</div><input type="text" id="editor-set-title" class="editor-set-input" data-kind="set-field" data-field="1" value="" /></div>
      <div class="editor-set-field"><div>ARTIST</div><input type="text" id="editor-set-artist" class="editor-set-input" data-kind="set-field" data-field="2" value="" /></div>
      <div class="editor-set-field"><div>MAPPER</div><input type="text" id="editor-set-mapper" class="editor-set-input" data-kind="set-field" data-field="3" value="" /></div>
      <div class="editor-set-field"><div>SONG SET TAGS</div><input type="text" id="editor-set-tags" class="editor-set-input" data-kind="set-field" data-field="4" value="" /></div>
      <div id="editor-set-hint" class="editor-setup-caption">ATTACH AUDIO, THEN OPEN THE DRAFT TO CREATE THE SET</div>
      <div id="editor-set-manage"><button data-action="set-bg"><span class="button-label">ADD BACKGROUND</span></button>
        <button data-action="set-remove-bg"><span class="button-label">REMOVE BG</span></button>
        <button data-action="set-import"><span class="button-label">IMPORT</span></button>
        <button data-action="set-export"><span class="button-label">EXPORT</span></button>
        <button data-action="set-folder"><span class="button-label">OPEN FOLDER</span></button>
        <button data-action="set-restore"><span class="button-label">RESTORE</span></button></div>
    </div>
    <div id="editor-set-audio" class="editor-set-panel">
      <div class="editor-set-title">AUDIO &amp; TIMING</div>
      <button id="editor-attach-audio" data-action="attach-audio"><span class="button-label">ATTACH AUDIO</span></button>
      <div id="editor-audio-name" class="editor-setup-caption"></div>
      <div class="editor-set-field"><div>MENU PREVIEW START / MS</div><input type="text" id="editor-preview-ms" class="editor-set-input" data-kind="preview-ms" maxlength="7" value="" /></div>
      <div class="editor-set-title editor-tempo-heading">TEMPO MAP</div>
      <button id="editor-tempo-suggestions" data-action="tempo-suggestions"><span class="button-label">DETECT BPM</span></button>
      <div id="editor-tempo-analysis-status" class="editor-setup-caption"></div>
      <div id="editor-tempo-labels" class="editor-tempo-row editor-tempo-labels"><div class="editor-tempo-offset">OFFSET / MS</div><div class="editor-tempo-bpm">BPM</div><div class="editor-tempo-action"></div></div>
      <div id="editor-tempo-list"></div>
      <div id="editor-proposal-list" style="display:none;"></div>
      <button id="editor-tempo-replace" data-action="tempo-replace" class="secondary" style="display:none;"><span class="button-label">REPLACE TEMPO MAP</span></button>
      <button id="editor-tempo-add" class="secondary" data-action="tempo-add"><span class="button-label">+ ADD BPM MARKER</span></button>
    </div>
    <div id="editor-set-difficulties" class="editor-set-panel">
      <div class="editor-set-title">DIFFICULTIES</div>
      <div class="editor-set-field"><div>DIFFICULTY NAME</div><input type="text" id="editor-difficulty-title" class="editor-set-input" data-kind="difficulty-title" value="" /></div>
      <div class="editor-set-quick"><button data-action="set-new"><span class="button-label">NEW</span></button><button data-action="set-duplicate"><span class="button-label">DUPLICATE</span></button></div>
      <div id="editor-set-list"><div id="editor-set-rows"></div></div>
      <div class="editor-setup-caption">CLICK TO SELECT · CLICK AGAIN OR ENTER TO EDIT</div>
      <div class="editor-set-quick"><button data-action="set-delete-chart"><span class="button-label">DELETE CHART</span></button><button data-action="set-delete-set"><span class="button-label">DELETE SET</span></button></div>
    </div>
  </div>
  <div id="editor-status-slot" style="display:none;"></div>
  <div id="editor-transport">
  <div id="editor-footer-playback">
    <button id="editor-preview-play" class="secondary" data-action="preview-play"><span class="button-label">PLAY</span></button>
    <button id="editor-preview-restart" class="quiet" data-action="preview-restart"><span class="button-label">RST</span></button>
    <button id="editor-metronome" class="quiet" data-action="metronome-toggle" title="METRONOME"><span class="button-label">MET</span></button>
  </div>
  <div id="editor-overview-slot" class="editor-canvas-slot"></div>
  <div id="editor-footer-rate-time">
    <div id="editor-rate-control"><input id="editor-preview-rate" type="text" value="100" data-kind="preview-rate" maxlength="3"/><span class="editor-rate-unit">%</span></div>
    <button id="editor-preview-time" class="quiet" data-action="time-copy"><span class="button-label">0 MS</span></button>
  </div>
  </div>
</div>
<div id="editor-compare-layer" class="ui-modal-layer" data-action="compare-dismiss" style="display:none;">
  <div id="editor-compare-panel" class="ui-modal-panel" data-action="compare-panel">
    <div class="ui-modal-heading">COMPARE CHARTS</div>
    <div class="meta">Same song · up to three open difficulties</div>
    <div id="editor-compare-list"><div id="editor-compare-rows"></div></div>
    <div id="editor-compare-notice" class="meta"></div>
    <div class="ui-modal-actions"><button id="editor-compare-done" class="secondary" data-action="compare-dismiss"><span class="button-label">DONE</span></button></div>
  </div>
</div>
</body>
</rml>
