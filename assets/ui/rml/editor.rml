<rml>
<head>
<title>LOCUS / EDITOR</title>
<link type="text/rcss" href="common.rcss" />
<link type="text/rcss" href="editor.rcss" />
</head>
<body>
<div id="editor-canvas">
  <div id="editor-header">
    <button id="editor-back" class="quiet" data-action="back"><span class="button-label">BACK</span></button>
    <div class="editor-caption">
      <span id="editor-chart-name">ORIGINAL</span>
      <span id="editor-dirty"></span>
    </div>
    <div class="editor-tabs">
      <button id="editor-tab-set" class="editor-tab" data-action="tab-set"><span class="button-label">SET</span></button>
      <button id="editor-tab-route" class="editor-tab selected" data-action="tab-route"><span class="button-label">ROUTE</span></button>
      <button id="editor-tab-audio" class="editor-tab" data-action="tab-audio"><span class="button-label">AUDIO</span></button>
    </div>
  </div>
  <div id="editor-route-ui">
    <div id="editor-route-tools">
    <button data-action="mirror-h" ><span class="button-label">↔</span></button>
    <button data-action="mirror-v" ><span class="button-label">↕</span></button>
    <button data-action="rotate-ccw" ><span class="button-label">↶</span></button>
    <button data-action="rotate-cw" ><span class="button-label">↷</span></button>
    <div id="editor-route-compare-gap" class="editor-tool-gap"></div>
    <button data-action="test-chart" ><span class="button-label">▷</span></button>
    </div>
    <div id="editor-route-pad">
    <button id="editor-pad-7" data-action="note" data-heading="7"><span class="button-label">↖</span><span id="editor-count-7" class="editor-pad-count">0</span></button>
    <button id="editor-pad-0" data-action="note" data-heading="0"><span class="button-label">↑</span><span id="editor-count-0" class="editor-pad-count">0</span></button>
    <button id="editor-pad-4" data-action="note" data-heading="4"><span class="button-label">↗</span><span id="editor-count-4" class="editor-pad-count">0</span></button>
    <button id="editor-pad-3" data-action="note" data-heading="3"><span class="button-label">←</span><span id="editor-count-3" class="editor-pad-count">0</span></button>
    <button data-action="remove-note" ><span class="button-label">DEL</span></button>
    <button id="editor-pad-1" data-action="note" data-heading="1"><span class="button-label">→</span><span id="editor-count-1" class="editor-pad-count">0</span></button>
    <button id="editor-pad-6" data-action="note" data-heading="6"><span class="button-label">↙</span><span id="editor-count-6" class="editor-pad-count">0</span></button>
    <button id="editor-pad-2" data-action="note" data-heading="2"><span class="button-label">↓</span><span id="editor-count-2" class="editor-pad-count">0</span></button>
    <button id="editor-pad-5" data-action="note" data-heading="5"><span class="button-label">↘</span><span id="editor-count-5" class="editor-pad-count">0</span></button>
    </div>
    <div id="editor-route-speed"><div class="editor-option-label">SPEED</div><div id="editor-speed-label" class="editor-option-value">135 px/s</div><button data-action="speed-minus" ><span class="button-label">−</span></button><button data-action="speed-plus" ><span class="button-label">+</span></button></div>
    <div id="editor-route-path"><div class="editor-option-label">PATH</div><div id="editor-path-label" class="editor-option-value">800 ms</div><button data-action="path-minus" ><span class="button-label">−</span></button><button data-action="path-plus" ><span class="button-label">+</span></button></div>
  </div>
  <div id="editor-footer-playback">
    <button id="editor-preview-play" class="secondary" data-action="preview-play"><span class="button-label">PLAY</span></button>
    <button id="editor-preview-restart" class="quiet" data-action="preview-restart"><span class="button-label">RST</span></button>
  </div>
  <div id="editor-footer-rate-time">
    <button id="editor-preview-rate" class="quiet" data-action="rate-toggle"><span class="button-label">100%</span></button>
    <button id="editor-preview-time" class="quiet" data-action="time-copy"><span class="button-label">0 MS</span></button>
  </div>
  <div id="editor-rate-popup" style="display:none;">
    <button class="editor-rate-choice quiet" data-action="rate" data-index="0"><span class="button-label">100%</span></button>
    <button class="editor-rate-choice quiet" data-action="rate" data-index="1"><span class="button-label">75%</span></button>
    <button class="editor-rate-choice quiet" data-action="rate" data-index="2"><span class="button-label">50%</span></button>
    <button class="editor-rate-choice quiet" data-action="rate" data-index="3"><span class="button-label">25%</span></button>
    <button class="editor-rate-choice quiet" data-action="rate" data-index="4"><span class="button-label">10%</span></button>
  </div>
</div>
</body>
</rml>
