/* Song selection: approved design/ui/v2 hierarchy at 960x540.
   RmlUi uses physical-pixel scaling configured by NativeMenuUi. */
#app { display:flex; flex-direction:column; width:100%; height:100%; }
#workspace { display:flex; flex:1; min-height:0; min-width:0;
  flex-direction:row; gap:12dp; padding:12dp 14dp; }
#details { flex:0 0 37%; width:37%; max-width:430dp; min-width:0;
  display:flex; flex-direction:column; overflow:hidden; }
#library { flex:1; display:flex; flex-direction:column; min-width:0;
  overflow:hidden; }
#summary { display:block; flex:0 1 auto; min-height:0; overflow-y:auto; }
#pack-section { display:block; padding:5dp 12dp 5dp;
  border-bottom:1dp #515572; }
#song-title { display:block; font-size:17dp; font-weight:750;
  margin:2dp 0 1dp; color:#f3f0ff; }
#song-author { display:block; font-size:12dp; color:#a2d8ee; font-weight:660; }
#song-mapper { display:block; font-size:11dp; color:#acb6cb; margin-top:2dp; }
#song-meta { display:block; font-size:11dp; font-weight:650;
  color:#d0c7fa; margin-top:2dp; }
#song-tags { display:block; font-size:10dp; color:#acb6cb; margin-top:3dp; }
#difficulty-section { display:block; padding:5dp 12dp 6dp;
  border-bottom:1dp #515572; }
.difficulty-heading { display:flex; flex-direction:row;
  align-items:center; justify-content:space-between; }
#rating { display:block; font-size:21dp; color:#d0c7fa; font-weight:850; }
#chart-title { display:block; font-size:15dp; font-weight:750;
  color:#eef1fb; margin-top:2dp; }
#chart-notes { display:block; font-size:11dp; color:#acb6cb;
  margin-top:5dp; }
#metrics { display:flex; flex-direction:column; gap:3dp; margin-top:4dp; }
.metrics-row { display:flex; flex-direction:row; gap:10dp; }
.metric { display:flex; flex:1; flex-direction:row; min-width:0;
  justify-content:space-between; align-items:center;
  font-size:10dp; color:#acb6cb; }
.metric strong { color:#e0def6; font-size:11dp; font-weight:750; }
#history { display:flex; flex-direction:column; flex:1 0 120dp; min-height:120dp;
  padding:0 11dp; }
.history-heading { display:flex; flex-direction:row;
  align-items:center; justify-content:space-between;
  flex:0 0 36dp; height:36dp; font-size:12dp;
  font-weight:800; letter-spacing:1dp; color:#a2d8ee; }
#results-scroll { flex:1; min-height:0; overflow-y:auto; }
#results-list { display:flex; flex-direction:column; gap:5dp;
  padding:2dp 0 7dp; }
.result-spacer { flex-shrink:0; width:1dp; }
.result { display:inline-block; flex:0 0 38dp; position:relative;
  width:100%; height:38dp; min-height:38dp; padding:0;
  text-align:left; font-size:12dp; border:1dp #545a79;
  background-color:#343a57; }
.result:hover { border-color:#b5a4f3; background-color:#484c73; }
.result .result-rank { left:9dp; right:auto; width:34dp; font-size:18dp;
  font-weight:800; text-align:center; }
.result .result-accuracy { left:52dp; right:56%; text-align:left;
  font-size:15dp; font-weight:700; }
.result .result-combo { left:72%; right:9dp; text-align:right;
  font-size:13dp; font-weight:650; color:#c0c9e2; }
#notice { display:block; color:#ecc3d1; padding:0 12dp;
  font-size:11dp; }
.library-heading { display:flex; flex-direction:row; align-items:center;
  justify-content:space-between; flex:0 0 44dp;
  padding:5dp 13dp 0; color:#a2d8ee;
  font-size:14dp; font-weight:750; letter-spacing:0.7dp; }
#search { flex:0 0 39dp; margin:3dp 12dp 9dp;
  width:auto; height:39dp; }
#tree-scroll { flex:1; min-height:0; overflow-y:auto;
  padding:0 10dp 2dp; }
#tree { display:flex; flex-direction:column; gap:6dp; }
.tree-spacer { flex-shrink:0; width:1dp; }
.song-row { display:flex; flex-direction:row; align-items:center;
  width:100%; min-height:45dp; height:45dp; text-align:left;
  background-color:#303750; border:1dp #535979; padding:5dp 12dp;
  font-size:15dp; font-weight:730; }
.song-row:hover { background-color:#454b6c; }
.song-row.active { background-color:#59517d; border-color:#b5a4f3; }
.chart-row { display:flex; flex-direction:row; align-items:center;
  width:96%; margin-left:4%; min-height:42dp; height:42dp;
  padding:5dp 12dp; text-align:left; font-size:13dp;
  background-color:#27344f; border:1dp #4e5878; }
.chart-row.active { background-color:#525b84; border-color:#a2d8ee; }
.chart-row:hover { background-color:#404e73; border-color:#9ed2e9; }
.row-chevron { display:inline-block; flex:0 0 9dp;
  width:9dp; height:9dp; border-top:2dp #b5a4f3;
  border-right:2dp #b5a4f3; transform:rotate(45deg);
  margin:0 10dp 0 3dp; }
.row-chevron.expanded { transform:rotate(135deg); }
.chart-marker { display:inline-block; width:7dp; height:7dp;
  border-radius:4dp; margin-right:9dp; background-color:#a2d8ee; }
.row-label { flex:1; min-width:0; overflow:hidden;
  white-space:nowrap; text-overflow:ellipsis; }
.row-count { font-size:12dp; color:#acb6cb; margin-left:10dp; }
.row-rating { font-size:13dp; font-weight:750; color:#d0c7fa;
  margin-left:10dp; }
#library-footer { display:flex; flex-direction:row;
  flex:0 0 59dp; padding:9dp 10dp; gap:7dp;
  border-top:1dp #505571; }
#library-footer button { flex:1; height:39dp; font-size:12dp;
  font-weight:700; letter-spacing:0.4dp; }
@media (max-width:800dp) {
  #workspace { gap:10dp; padding:8dp; }
  #details { flex-basis:43%; width:43%; }
  #pack-section, #difficulty-section { padding-left:11dp; padding-right:11dp; }
}
@media (max-height:510dp) {
  #pack-section { padding-top:8dp; padding-bottom:7dp; }
  #difficulty-section { padding-top:7dp; padding-bottom:7dp; }
}

@media (max-width:650dp) {
  .result .result-rank { left:5dp; width:26dp; font-size:15dp; }
  .result .result-accuracy { left:35dp; font-size:12dp; }
  .result .result-combo { right:5dp; font-size:11dp; }
}
.result .result-mod { left:44%; right:28%; text-align:center; font-size:10dp; color:#c1b3ea; overflow:hidden; white-space:nowrap; }
#mods-overlay { display:none; position:absolute; left:0; top:0; width:100%; height:100%; background-color:#090b15e8; align-items:center; justify-content:center; }
#mods-panel { display:flex; flex-direction:column; width:70%; max-width:560dp; height:90%; max-height:510dp; padding:10dp 15dp; gap:5dp; }
.mods-heading { display:flex; flex-direction:row; justify-content:space-between; align-items:center; color:#d0c7fa; font-size:15dp; font-weight:750; flex-shrink:0; }
.mods-heading button { width:90dp; height:30dp; }
#mods-content { flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column; gap:5dp; }
.mods-row, .rate-row { display:flex; flex-direction:row; align-items:center; gap:8dp; flex-shrink:0; }
.mods-row button { flex:1; height:32dp; font-size:12dp; }
.rate-row button { flex:0 0 125dp; height:32dp; font-size:12dp; }
.rate-row input { flex:1; min-width:0; height:30dp; }
.rate-row span { font-size:12dp; }
#mod-ht-label, #mod-dt-label { width:46dp; text-align:right; color:#a2d8ee; }
#mods-panel button.selected { background-color:#6c579a; border:1dp #d5c5ff; }
#mods-button.selected { border:1dp #d5c5ff; background-color:#6c579a; }
input.range slidertrack, input[type="range"] slidertrack { background-color:#40465f; height:5dp; }
input.range sliderbar, input[type="range"] sliderbar { background-color:#b5a4f3; width:12dp; height:20dp; }

