/* Nightbloom: adaptive menu-only layout. Do not apply to scored gameplay. */
#app { display:flex; flex-direction:column; width:100%; height:100%; padding:2.1vh 2.2vw 2.0vh; }
#heading { flex:0 0 52dp; display:flex; align-items:center; gap:22dp; margin-bottom:10dp; }
.heading-title { font-size:21dp; color:#a2d8ee; letter-spacing:1dp; }
.back { width:115dp; height:43dp; flex:0 0 115dp; }
#workspace { display:flex; flex-direction:row; flex:1; min-height:0; width:100%; gap:16dp; }
#details { display:flex; flex-direction:column; flex:0 0 36%; min-width:260dp; max-width:520dp; }
#library { display:flex; flex-direction:column; flex:1; min-width:0; }
#song-title { font-size:23dp; font-weight:600; margin:8dp 0 5dp; }
#chart-title { font-size:19dp; font-weight:500; margin:4dp 0; }
.difficulty-heading { display:flex; flex-direction:row; justify-content:space-between; align-items:center; }
#rating { color:#a2d8ee; font-size:28dp; }
.metric { font-size:12dp; color:#b7bdd5; margin-top:5dp; }
#history { display:flex; flex-direction:column; flex:1; min-height:90dp;
  margin-top:12dp; border-top:1dp #454d70; padding-top:12dp; }
.history-heading { color:#a2d8ee; font-size:13dp; margin-bottom:10dp; }
#result-count { color:#baabf5; margin-left:15dp; }
#results-scroll { flex:1; min-height:0; overflow-y:auto; }
#results-list { display:flex; flex-direction:column; gap:6dp; padding-right:5dp; }
.result { display:flex; flex-direction:row; justify-content:space-between;
  align-items:center; text-align:left; width:100%; padding:10dp 12dp;
  background-color:#323a57; font-size:12dp; }
.result strong { color:#a2d8ee; font-size:16dp; }
.result span { color:#b9c2d9; font-size:11dp; }
#notice { color:#a2d8ee; font-size:12dp; margin-top:3dp; }
#commands { display:flex; flex-direction:row; flex:0 0 46dp; gap:12dp; padding-top:8dp; }
#commands button { flex:1; padding:7dp; height:44dp; }
.library-heading { color:#a2d8ee; font-size:19dp; margin-bottom:12dp; }
#search { margin-bottom:12dp; }

#tree-scroll { flex:1; min-height:0; overflow-y:auto; padding-right:4dp; }
#tree { display:flex; flex-direction:column; gap:5dp; }
.song-row { width:100%; min-height:40dp; text-align:left; border-radius:9dp;
  background-color:#303650; border:1dp #545a7d; padding:7dp 11dp; }
.song-row.active { background-color:#444568; border-color:#b2a4ef; }
.chart-row { width:95%; margin-left:5%; min-height:41dp;
  background-color:#2b3555; text-align:left; border-radius:9dp;
  border:1dp #424d70; padding:7dp 11dp; display:flex;
  flex-direction:row; justify-content:space-between; align-items:center; }
.chart-row.active { background-color:#625c91; border-color:#a2d8ee; }
.row-rating { color:#a2d8ee; margin-left:10dp; }
#library-footer { flex:0 0 46dp; display:flex; flex-direction:row;
  justify-content:space-between; align-items:center; padding-top:8dp; }
#row-count { color:#a9b7ce; font-size:12dp; }
.quiet { min-width:115dp; height:38dp; font-size:14dp; padding:6dp 12dp; }
@media (max-width:800dp) {
  #workspace { flex-direction:column; overflow-y:auto; }
  #details { flex:0 0 auto; min-width:0; max-width:none; }
  #history { min-height:110dp; max-height:180dp; }
  #library { flex:1; min-height:250dp; }
  .panel { padding:12dp 14dp; }
}
@media (min-width:1700dp) {
  #details { flex-basis:30%; }
  .panel { padding:22dp 28dp; }
  #song-title { font-size:28dp; }
}
