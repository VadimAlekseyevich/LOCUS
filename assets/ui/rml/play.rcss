/* Nightbloom: adaptive menu-only layout. Do not apply to scored gameplay. */
body {
  margin:0; padding:0; width:100%; height:100%;
  background-color: transparent;
  color:#eef1fb;
  font-family:Locus;
  font-size:16px;
}
* { box-sizing:border-box; }
#app { display:flex; flex-direction:column; width:100%; height:100%; padding:2.1vh 2.2vw 2.0vh; }
#heading { flex:0 0 52px; display:flex; align-items:center; gap:22px; margin-bottom:10px; }
.heading-title { font-size:21px; color:#a2d8ee; letter-spacing:1px; }
button { color:#eff2ff; font-family:Locus; font-size:15px; background-color:#303650;
  border:1px #62698c; border-radius:13px; padding:10px 18px; cursor:pointer; }
button:hover { background-color:#444e72; border-color:#a2d8ee; }
button:active { background-color:#5b628e; }
button:focus { border-color:#a2d8ee; }
.back { width:115px; height:43px; flex:0 0 115px; }
#workspace { display:flex; flex-direction:row; flex:1; min-height:0; width:100%; gap:16px; }
.panel { background-color:#1e2437ed; border:1px #4c5079d0; border-radius:16px;
  padding:18px 20px; min-width:0; min-height:0; }
#details { display:flex; flex-direction:column; flex:0 0 36%; min-width:260px; max-width:520px; }
#library { display:flex; flex-direction:column; flex:1; min-width:0; }
.eyebrow { color:#baabf5; font-size:11px; letter-spacing:1px; }
#song-title { font-size:23px; font-weight:600; margin:8px 0 5px; }
#chart-title { font-size:19px; font-weight:500; margin:4px 0; }
.subline { color:#a2d8ee; margin:0 0 8px; font-size:14px; }
.meta { font-size:12px; color:#a5b1cb; margin:7px 0; }
.rule { height:1px; background-color:#454d70; margin:13px 0; }
.difficulty-heading { display:flex; flex-direction:row; justify-content:space-between; align-items:center; }
#rating { color:#a2d8ee; font-size:28px; }
.metric { font-size:12px; color:#b7bdd5; margin-top:5px; }
#history { display:flex; flex-direction:column; flex:1; min-height:90px;
  margin-top:12px; border-top:1px #454d70; padding-top:12px; }
.history-heading { color:#a2d8ee; font-size:13px; margin-bottom:10px; }
#result-count { color:#baabf5; margin-left:15px; }
#results-scroll { flex:1; min-height:0; overflow-y:auto; }
#results-list { display:flex; flex-direction:column; gap:6px; padding-right:5px; }
.result { display:flex; flex-direction:row; justify-content:space-between;
  align-items:center; text-align:left; width:100%; padding:10px 12px;
  background-color:#323a57; font-size:12px; }
.result strong { color:#a2d8ee; font-size:16px; }
.result span { color:#b9c2d9; font-size:11px; }
.empty { padding:13px 5px; color:#97a6c4; }
#commands { display:flex; flex-direction:row; flex:0 0 46px; gap:12px; padding-top:8px; }
#commands button { flex:1; padding:7px; height:44px; }
.primary { background-color:#a2d8ee; color:#20253b; border-color:#a2d8ee; }
.primary:hover { background-color:#c7ecf8; }
.secondary { background-color:#b2a4ef; color:#25243a; border-color:#b2a4ef; }
.secondary:hover { background-color:#cec6fc; }
.library-heading { color:#a2d8ee; font-size:19px; margin-bottom:12px; }
#search { display:block; width:100%; height:44px; background-color:#303650;
  border:1px #444d71; border-radius:12px; padding:7px 15px; margin-bottom:12px;
  font-family:Locus; font-size:15px; color:#eef1fb; }
#search:focus { border-color:#a2d8ee; background-color:#3a4264; }
#tree-scroll { flex:1; min-height:0; overflow-y:auto; padding-right:4px; }
#tree { display:flex; flex-direction:column; gap:5px; }
.song-row { width:100%; min-height:40px; text-align:left; border-radius:9px;
  background-color:#303650; border:1px #545a7d; padding:7px 11px; }
.song-row.active { background-color:#444568; border-color:#b2a4ef; }
.chart-row { width:95%; margin-left:5%; min-height:41px;
  background-color:#2b3555; text-align:left; border-radius:9px;
  border:1px #424d70; padding:7px 11px; display:flex;
  flex-direction:row; justify-content:space-between; align-items:center; }
.chart-row.active { background-color:#625c91; border-color:#a2d8ee; }
.row-rating { color:#a2d8ee; margin-left:10px; }
#library-footer { flex:0 0 46px; display:flex; flex-direction:row;
  justify-content:space-between; align-items:center; padding-top:8px; }
#row-count { color:#a9b7ce; font-size:12px; }
.quiet { min-width:115px; height:38px; font-size:14px; padding:6px 12px; }
@media (max-width:800px) {
  #workspace { flex-direction:column; overflow-y:auto; }
  #details { flex:0 0 auto; min-width:0; max-width:none; }
  #history { min-height:110px; max-height:180px; }
  #library { flex:1; min-height:250px; }
  .panel { padding:12px 14px; }
}
@media (min-width:1700px) {
  #details { flex-basis:30%; }
  .panel { padding:22px 28px; }
  #song-title { font-size:28px; }
}
