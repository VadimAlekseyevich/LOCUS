# Every LOCUS implementation file belongs to exactly one compile target.
# Tests may add their own fixtures; third-party targets are in subdirectories.
# Run after all first-party targets in this directory have been declared.
function(locus_verify_source_ownership)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    set(owned)
    set(report "source,target\n")
    foreach(target IN LISTS targets)
        get_target_property(sources ${target} SOURCES)
        if(NOT sources)
            continue()
        endif()
        foreach(source IN LISTS sources)
            if(source MATCHES "^\\$<")
                continue()
            endif()
            cmake_path(ABSOLUTE_PATH source
                BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE absolute)
            cmake_path(RELATIVE_PATH absolute BASE_DIRECTORY "${PROJECT_SOURCE_DIR}"
                OUTPUT_VARIABLE relative)
            if(NOT relative MATCHES "^src/(app|core)/.*[.]cpp$")
                continue()
            endif()
            if(relative IN_LIST owned)
                message(FATAL_ERROR "Duplicate LOCUS translation unit: ${relative} (${target}); link its owning module instead")
            endif()
            list(APPEND owned "${relative}")
            string(APPEND report "${relative},${target}\n")
        endforeach()
    endforeach()
    list(LENGTH owned count)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/locus-source-ownership.csv" "${report}")
    message(STATUS "LOCUS_SOURCE_OWNERSHIP: ${count} unique implementation units")
endfunction()
