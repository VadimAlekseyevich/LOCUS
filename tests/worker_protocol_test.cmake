# Exercise the exact executable/JSON protocol a future backend will use.
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/stage")
execute_process(COMMAND "${FIXTURE}" "${WORK_DIR}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Worker fixture failed: ${rc}")
endif()
function(run_worker expected)
    execute_process(COMMAND "${WORKER}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE response ERROR_VARIABLE diagnostic
        TIMEOUT 30 OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT "${rc}" STREQUAL "${expected}")
        message(FATAL_ERROR "Worker returned ${rc}; expected ${expected}: ${response} ${diagnostic}")
    endif()
    string(JSON version GET "${response}" protocolVersion)
    string(JSON ok GET "${response}" ok)
    if(NOT version EQUAL 1 OR (expected EQUAL 0 AND NOT ok) OR
        (NOT expected EQUAL 0 AND ok))
        message(FATAL_ERROR "Unexpected worker response: ${response}")
    endif()
    set(response "${response}" PARENT_SCOPE)
endfunction()
set(stage "${WORK_DIR}/stage")
run_worker(0 inspect "${WORK_DIR}/fixture.locuspack" "${stage}")
string(JSON digest GET "${response}" difficulties 0 gameplaySha256)
string(JSON id GET "${response}" difficulties 0 difficultyId)
string(JSON media GET "${response}" mediaValidated)
if(media OR NOT id STREQUAL "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    message(FATAL_ERROR "Incorrect inspection response: ${response}")
endif()
run_worker(0 verify "${stage}" "${id}" "${digest}" 3000 100 0 0 "${WORK_DIR}/valid.replay")
string(JSON perfect GET "${response}" grades perfect)
string(JSON acc GET "${response}" accuracyPercent)
string(JSON pp GET "${response}" pp)
string(JSON rank GET "${response}" rankApproved)
if(NOT perfect EQUAL 3 OR NOT acc EQUAL 100 OR NOT pp GREATER 0 OR rank)
    message(FATAL_ERROR "Incorrect derived score: ${response}")
endif()
foreach(file offset finish late partial)
    run_worker(2 verify "${stage}" "${id}" "${digest}" 3000 100 0 0 "${WORK_DIR}/${file}.replay")
endforeach()
run_worker(2 verify "${stage}" "${id}" "${digest}" 3000 125 0 0 "${WORK_DIR}/valid.replay")
run_worker(2 verify "${stage}" "${id}" "${digest}" 1500 100 0 0 "${WORK_DIR}/valid.replay")
string(REPEAT "0" 64 wrong)
run_worker(2 verify "${stage}" "${id}" "${wrong}" 3000 100 0 0 "${WORK_DIR}/valid.replay")
file(WRITE "${stage}/music.wav" "mutated audio")
run_worker(2 verify "${stage}" "${id}" "${digest}" 3000 100 0 0 "${WORK_DIR}/valid.replay")
file(REMOVE_RECURSE "${WORK_DIR}")
